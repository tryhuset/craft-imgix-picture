{
  "name": "apt/craft-imgix-picture",
  "description": "Create responsive image tags and json objects from config file, using the imgIX service.",
  "type": "craft-plugin",
  "version": "3.0.2",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "craft imgix picture"
  ],
  "support": {
    "docs": "https://github.com/tryhuset/craft-imgix-picture",
    "issues": "https://github.com/tryhuset/craft-imgix-picture/-/issues"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Apt as",
      "homepage": "https://try.no"
    }
  ],
  "require": {
    "craftcms/cms": "^5.0",
    "imgix/imgix-php": "~3.3.0"
  },
  "autoload": {
    "psr-4": {
      "apt\\craftimgixpicture\\": "src/"
    }
  },
  "extra": {
    "name": "Craft Imgix Picture",
    "handle": "craft-imgix-picture",
    "developer": "Apt as",
    "developerUrl": "https://apt.no",
    "documentationUrl": "https://github.com/tryhuset/craft-imgix-picture/-/blob/main/README.md",
    "changelogUrl": "https://github.com/tryhuset/craft-imgix-picture/-/blob/main/README.md",
    "components": {
      "service": "apt\\craftimgixpicture\\services\\Service",
      "imgix": "apt\\craftimgixpicture\\services\\Imgix"
    },
    "class": "apt\\craftimgixpicture\\CraftImgixPicture"
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
