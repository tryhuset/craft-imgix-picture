{
    "name": "apt/craft-imgix-picture",
    "description": "Create responsive image tags and json objects from config file, using the imgIX service.",
    "type": "craft-plugin",
    "version": "2.0.4",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "craft imgix picture"
    ],
    "support": {
        "docs": "https://git1.apt.no/open/craft-imgix-picture",
        "issues": "https://git1.apt.no/open/craft-imgix-picture/-/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Apt as",
            "homepage": "https://apt.no"
        }
    ],
    "require": {
        "craftcms/cms": "^4.0",
        "imgix/imgix-php": "~3.3.0"
    },
    "autoload": {
        "psr-4": {
            "apt\\craftimgixpicture\\": "src/"
        }
    },
    "extra": {
        "name": "Craft Imgix Picture",
        "handle": "craft-imgix-picture",
        "developer": "Apt as",
        "developerUrl": "https://apt.no",
        "documentationUrl": "https://git1.apt.no/open/craft-imgix-picture/-/blob/master/README.md",
        "changelogUrl": "https://git1.apt.no/open/craft-imgix-picture/-/blob/master/README.md",
        "components": {
            "service": "apt\\craftimgixpicture\\services\\Service",
            "imgix": "apt\\craftimgixpicture\\services\\Imgix"
        },
        "class": "apt\\craftimgixpicture\\CraftImgixPicture"
    },
    "config": {
        "platform": {
            "php": "8.0.2"
        }
    }
}
